# ======================================================================
# JopTrades — Solana / pump.fun auto-trader
# Copy to .env and fill in.  NEVER commit .env.
# ======================================================================

# --- Claude Code proxy -------------------------------------------------
# The proxy (claude-proxy/server.mjs) wraps the Claude Agent SDK, which
# authenticates via your local Claude Code login / subscription. No API
# key needed if you are logged into Claude Code on this machine.
CLAUDE_PROXY_URL=http://localhost:8787
CLAUDE_PROXY_PORT=8787
# Model the proxy asks Claude Code to use for analysis.
CLAUDE_MODEL=claude-opus-4-8

# --- Solana wallet -----------------------------------------------------
# The trading wallet's private key, base58 (Phantom "export private key"
# format) OR a JSON array of bytes. This wallet holds and spends REAL SOL.
# Use a dedicated burner wallet funded with only what you can lose.
SOLANA_PRIVATE_KEY=

# Solana RPC. The public endpoint is rate-limited and slow — use a paid
# one (Helius, QuickNode, Triton) for anything real.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- pump.fun execution mode ------------------------------------------
# local  = non-custodial: we build the tx via PumpPortal, sign it with
#          SOLANA_PRIVATE_KEY, and send it through SOLANA_RPC_URL. (default)
# lightning = custodial: PumpPortal holds a wallet you fund; needs an API key.
EXECUTION_MODE=local
PUMPPORTAL_API_KEY=

# Data websocket also accepts the api key (needed only for paid trade streams).
PUMPPORTAL_WS_API_KEY=

# --- Trade sizing & safety caps (all amounts in SOL) -------------------
BUY_AMOUNT_SOL=0.05          # size of each new-position buy
MAX_POSITION_SOL=0.10        # hard cap: refuse any single buy above this
MAX_OPEN_POSITIONS=3         # don't hold more than this many coins at once
MAX_DAILY_SPEND_SOL=0.50     # hard cap: total buys per UTC day
SLIPPAGE_PERCENT=10          # max slippage tolerance sent to PumpPortal
PRIORITY_FEE_SOL=0.00005     # Solana priority fee per tx
MIN_CONFIDENCE=0.65          # ignore Claude BUY calls below this confidence

# Claude usage control (protects your subscription / API bill):
# Every interval, only the ONE strongest buffered launch is sent to Claude.
ANALYZE_INTERVAL_MS=90000    # ms between analyses. Bigger = less usage (90s = 40/hr)
MIN_CREATOR_BUY_SOL=0.3      # a launch needs at least this creator buy-in to qualify

# Exit rules (fraction of entry). 0.5 = take profit at +50%, etc.
TAKE_PROFIT_PCT=0.5
STOP_LOSS_PCT=0.3

# --- Live-trading guards ----------------------------------------------
# DRY_RUN=true logs the trades it WOULD make but sends nothing on-chain.
# Start here. Set to false only when you've watched it behave.
DRY_RUN=true

# Second guard: even with DRY_RUN=false, the bot refuses to send real
# trades unless this is exactly "true". Deliberate friction, on purpose.
I_UNDERSTAND_LIVE_TRADING=false

# Kill switch: set to true to make the bot analyze but never buy.
KILL_SWITCH=false
